---
import Base from '../layouts/Base.astro';
import Bandeirinhas from '../components/Bandeirinhas.astro';
import projetos from '../data/projetos.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const lista = [...projetos].sort((a, c) => c.ano - a.ano);
const fundos = [['#0b4a1e', '#fff', '#e8b93c'], ['#1f3f8f', '#fff', '#e8b93c'], ['#c8420a', '#fff', '#fff'], ['#e8b93c', '#072f15', '#072f15']];
---
<Base titulo="Projetos" descricao="Projetos da Matutos Elegantes organizados por edital e ano.">
  <div class="pagina-topo pg-projetos">
    <Bandeirinhas />
    <div class="wrap"><div class="trilha"><a href={`${b}/`}>Início</a> / Projetos</div><h1 data-split>Projetos</h1><p>Do mais recente ao mais antigo, organizados por edital e ano.</p></div>
  </div>
  <section><div class="wrap">
    {lista.map((p, i) => (
      <article class="proj-cor reveal" id={p.id} style={`--bg:${fundos[i % fundos.length][0]};--fg:${fundos[i % fundos.length][1]};--num:${fundos[i % fundos.length][2]}`}>
        <div class="proj-ano" aria-hidden="true">{p.ano}</div>
        <div class="proj-info">
          <span class="tag">{p.edital}</span>
          {p.titulo !== String(p.ano) && <h2>{p.titulo}</h2>}
          <p>{p.resumo}</p>
          {p.fotos.length
            ? <div class="galeria">{p.fotos.map((f) => <div><img src={`${b}/projetos/${f.src}`} alt={f.alt} loading="lazy" /></div>)}</div>
            : <div class="vazio">Registro fotográfico em breve.</div>}
        </div>
      </article>
    ))}
  </div></section>
</Base>
