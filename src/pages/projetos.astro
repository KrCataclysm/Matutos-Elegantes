---
import Base from '../layouts/Base.astro';
import Bandeirinhas from '../components/Bandeirinhas.astro';
import projetos from '../data/projetos.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const lista = [...projetos].sort((a, c) => c.ano - a.ano);
const fundos = [['#c8420a', '#fff'], ['#0a7d8e', '#fff'], ['#6b3fa0', '#fff'], ['#c2246a', '#fff'], ['#1f4fa8', '#fff']];
---
<Base titulo="Projetos">
  <div class="pagina-topo pg-projetos"><Bandeirinhas /><div class="wrap"><h1>Projetos</h1><p>Do mais recente ao mais antigo, organizados por edital e ano.</p></div></div>
  <div class="faixa"></div>
  <section><div class="wrap">
    {lista.map((p, i) => (
      <article class="proj-cor reveal" id={p.id} style={`--bg:${fundos[i % fundos.length][0]};--fg:${fundos[i % fundos.length][1]}`}>
        <div class="proj-ano" aria-hidden="true">{p.ano}</div>
        <div class="proj-info">
          <span class="tag">{p.edital}</span>
          {p.titulo !== String(p.ano) && <h2>{p.titulo}</h2>}
          <p>{p.resumo}</p>
          {p.fotos.length
            ? <div class="galeria">{p.fotos.map((f) => <img src={`${b}/projetos/${f.src}`} alt={f.alt} loading="lazy" />)}</div>
            : <div class="vazio">Registro fotográfico em breve.</div>}
        </div>
      </article>
    ))}
  </div></section>
</Base>
