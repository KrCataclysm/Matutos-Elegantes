---
import Base from '../layouts/Base.astro';
import projetos from '../data/projetos.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const lista = [...projetos].sort((a, c) => c.ano - a.ano);
const cores = ['var(--verde)'];
---
<Base titulo="Projetos" descricao="Projetos da Matutos Elegantes organizados por edital e ano.">
  <div class="pagina-topo pg-projetos"><div class="wrap"><div class="trilha"><a href={`${b}/`}>Início</a> / Projetos</div><h1>Projetos</h1><p>Do mais recente ao mais antigo, organizados por edital e ano.</p></div></div>
  <div class="regua" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <section><div class="wrap">
    {lista.map((p, i) => (
      <article class="projeto reveal" id={p.id} style={`--cor:${cores[i % cores.length]}`}>
        <div class="ano" aria-hidden="true">{p.ano}</div>
        <div>
          <span class="tag">{p.edital}</span>
          {p.titulo !== String(p.ano) && <h2>{p.titulo}</h2>}
          <p>{p.resumo}</p>
          {p.fotos.length
            ? <div class="galeria">{p.fotos.map((f) => <img src={`${b}/projetos/${f.src}`} alt={f.alt} loading="lazy" />)}</div>
            : <div class="vazio">Registro fotográfico em breve.</div>}
        </div>
      </article>
    ))}
  </div></section>
</Base>
