---
import Base from '../layouts/Base.astro';
import Bandeirinhas from '../components/Bandeirinhas.astro';
import projetos from '../data/projetos.json';
import site from '../data/site.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const atual = [...projetos].sort((a, c) => c.ano - a.ano)[0];
const itens = [
  ['01', 'Sobre nós', 'Quem somos, nossa missão e o que fazemos pela cultura.', '/sobre', 'var(--terra)'],
  ['02', 'Projetos', 'Ações realizadas, organizadas por edital e por ano.', '/projetos', 'var(--anil)'],
  ['03', 'Transparência', 'Prestação de contas clara e aberta a toda a comunidade.', '/transparencia', 'var(--mata)'],
  ['04', 'Contato', 'Parcerias, projetos e apoio à cultura popular.', '/contato', 'var(--terra)'],
];
const palavras = ['Cultura popular', 'Tradição', 'Arte', 'Identidade', 'Comunidade', 'Festa', 'Memória'];
---
<Base>
  <div class="hero">
    <Bandeirinhas />
    <div class="wrap hero-grid">
      <div>
        <span class="rotulo">Ponto de Cultura · Associação Cultural</span>
        <h1 data-split>Cultura popular com orgulho e <em>cor</em></h1>
        <p>Conheça a nossa história e os projetos que realizamos.</p>
        <div class="acoes">
          <a class="btn" data-magnetic href={`${b}/projetos`}>Ver projetos →</a>
          <a class="btn sec" data-magnetic href={`${b}/sobre`}>Quem somos</a>
        </div>
      </div>
      <div class="hero-logo"><img data-tilt src={`${b}/logo/logo-escuro.png`} alt="Matutos Elegantes — Ponto de Cultura, Associação Cultural" /></div>
    </div>
  </div>

  <div class="marquee" aria-hidden="true"><div>{[...Array(8)].flatMap(() => palavras).map((t) => <span>{t}<b></b></span>)}</div></div>

  <section>
    <div class="wrap">
      <span class="rotulo reveal">O que fazemos</span>
      <h2 data-split style="max-width:16ch">Cultura que move a comunidade</h2>
      <p class="sub reveal">Uma associação cultural reconhecida como Ponto de Cultura, dedicada a valorizar a arte, a tradição e a identidade do nosso povo.</p>
      <div class="lista">
        {itens.map(([n, t, d, h, c]) => (
          <a class="reveal" href={`${b}${h}`} style={`--cor:${c}`}><span class="n">{n}</span><h3>{t}</h3><span class="seta">→</span><p>{d}</p></a>
        ))}
      </div>
    </div>
  </section>

  <section class="scrub-sec escuro">
    <div class="wrap">
      <span class="rotulo">O que nos move</span>
      <p class="scrub" data-scrub>Cultura popular. Tradição. Arte. Identidade. Comunidade. Festa. Memória.</p>
    </div>
  </section>

  <section class="destaque">
    <div class="wrap">
      <div class="reveal">
        <span class="rotulo">Em destaque</span>
        <h2>{atual.titulo}</h2>
        <p>{atual.resumo}</p>
        <a class="btn escuro" data-magnetic href={`${b}/projetos#${atual.id}`}>Conhecer o projeto →</a>
      </div>
      <div class="ano" aria-label={String(atual.ano)}><span data-count={atual.ano} data-from={atual.ano - 8}>{atual.ano}</span><small>{atual.edital}</small></div>
    </div>
  </section>

  <section class="insta">
    <div class="wrap reveal">
      <div>
        <h2>Acompanhe no Instagram</h2>
        <p>Novidades, eventos e bastidores dos nossos projetos.</p>
      </div>
      <a class="btn" data-magnetic href={site.instagram} rel="noopener">Seguir {site.instagramUsuario} →</a>
    </div>
  </section>
</Base>
