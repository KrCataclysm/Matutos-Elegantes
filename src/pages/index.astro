---
import Base from '../layouts/Base.astro';
import projetos from '../data/projetos.json';
import site from '../data/site.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const atual = [...projetos].sort((a, c) => c.ano - a.ano)[0];
const itens = [
  ['01', 'Sobre nós', 'Quem somos, nossa missão e o que fazemos pela cultura.', '/sobre', 'var(--laranja-t)'],
  ['02', 'Projetos', 'Ações realizadas, organizadas por edital e por ano.', '/projetos', 'var(--azul)'],
  ['03', 'Transparência', 'Prestação de contas clara e aberta a toda a comunidade.', '/transparencia', 'var(--roxo)'],
  ['04', 'Contato', 'Parcerias, projetos e apoio à cultura popular.', '/contato', 'var(--ciano-t)'],
];
---
<Base>
  <div class="hero">
    <div class="wrap">
      <div>
        <span class="rotulo" style="color:var(--palha)">Ponto de Cultura · Associação Cultural</span>
        <h1>Cultura popular com orgulho e <em>cor</em></h1>
        <p>Conheça a nossa história e os projetos que realizamos.</p>
        <div class="acoes">
          <a class="btn" href={`${b}/projetos`}>Ver projetos</a>
          <a class="btn vazado" href={`${b}/sobre`}>Quem somos</a>
        </div>
      </div>
      <img class="logo" src={`${b}/logo/logo-escuro.png`} alt="Matutos Elegantes — Ponto de Cultura, Associação Cultural" />
    </div>
  </div>
  <div class="regua" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>

  <section>
    <div class="wrap">
      <span class="rotulo reveal" style="color:var(--laranja-t)">O que fazemos</span>
      <h2 class="reveal" style="max-width:16ch">Cultura que move a comunidade</h2>
      <p class="texto-grande reveal" style="max-width:40rem;color:var(--suave)">Uma associação cultural reconhecida como Ponto de Cultura, dedicada a valorizar a arte, a tradição e a identidade do nosso povo.</p>
      <div class="lista">
        {itens.map(([n, t, d, h, c]) => (
          <a class="reveal" href={`${b}${h}`} style={`--cor:${c}`}><span class="n">{n}</span><h3>{t}</h3><span class="seta">→</span><p>{d}</p></a>
        ))}
      </div>
    </div>
  </section>

  <section class="destaque">
    <div class="wrap">
      <div class="reveal">
        <span class="rotulo">Em destaque</span>
        <h2>{atual.titulo}</h2>
        <p>{atual.resumo}</p>
        <a class="btn" href={`${b}/projetos#${atual.id}`}>Conhecer o projeto</a>
      </div>
      <div class="ano reveal" aria-hidden="true">{atual.ano}<small>{atual.edital}</small></div>
    </div>
  </section>

  <section class="parceria">
    <div class="wrap reveal">
      <div>
        <span class="rotulo" style="color:var(--palha)">Parcerias e apoio</span>
        <h2>Vamos fazer cultura juntos</h2>
        <p>Instituições, produtores, artistas e apoiadores: fale com a gente para construir novas ações.</p>
      </div>
      <div class="acoes">
        <a class="btn" href={`${b}/contato`}>Entrar em contato</a>
        <a class="btn vazado" href={`${b}/transparencia`}>Transparência</a>
      </div>
    </div>
  </section>

  <section class="insta">
    <div class="wrap reveal">
      <div>
        <h2>Acompanhe no Instagram</h2>
        <p>Novidades, eventos e bastidores dos nossos projetos.</p>
      </div>
      <a class="btn escuro" href={site.instagram} rel="noopener">Seguir {site.instagramUsuario}</a>
    </div>
  </section>
</Base>
