---
import Base from '../layouts/Base.astro';
import Bandeirinhas from '../components/Bandeirinhas.astro';
import site from '../data/site.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titulo="Contato" descricao="Fale com a Associação Cultural Matutos Elegantes.">
  <div class="pagina-topo pg-contato">
    <Bandeirinhas />
    <div class="wrap"><div class="trilha"><a href={`${b}/`}>Início</a> / Contato</div><h1 data-split>Contato</h1><p>Fale com a gente — parcerias, projetos e apoio à cultura.</p></div>
  </div>
  <section><div class="wrap">
    <div class="contato-blocos">
      <a class="c-bloco c-verde reveal" data-magnetic href={`mailto:${site.email}`}><span>E-mail</span><strong>{site.email}</strong><i aria-hidden="true">→</i></a>
      <a class="c-bloco c-terra reveal" data-magnetic href={site.instagram} rel="noopener"><span>Instagram</span><strong>{site.instagramUsuario}</strong><i aria-hidden="true">→</i></a>
    </div>
    {site.formspree && (
      <form action={site.formspree} method="POST">
        <input name="nome" placeholder="Seu nome" required />
        <input name="email" type="email" placeholder="Seu e-mail" required />
        <textarea name="mensagem" rows="5" placeholder="Mensagem" required></textarea>
        <button class="btn" type="submit">Enviar</button>
      </form>
    )}
  </div></section>
</Base>
