---
import Base from '../layouts/Base.astro';
import Bandeirinhas from '../components/Bandeirinhas.astro';
import site from '../data/site.json';
---
<Base titulo="Contato">
  <div class="pagina-topo pg-contato"><Bandeirinhas /><div class="wrap"><h1>Contato</h1><p>Fale com a gente — parcerias, projetos e apoio à cultura.</p></div></div>
  <div class="faixa"></div>
  <section><div class="wrap">
    <div class="contato-blocos">
      <a class="c-bloco c-verde reveal" href={`mailto:${site.email}`}><span>E-mail</span><strong>{site.email}</strong><i aria-hidden="true">→</i></a>
      <a class="c-bloco c-rosa reveal" href={site.instagram} rel="noopener"><span>Instagram</span><strong>{site.instagramUsuario}</strong><i aria-hidden="true">→</i></a>
    </div>
    {site.formspree && (
      <form action={site.formspree} method="POST">
        <input name="nome" placeholder="Seu nome" required />
        <input name="email" type="email" placeholder="Seu e-mail" required />
        <textarea name="mensagem" rows="5" placeholder="Mensagem" required></textarea>
        <button class="btn" type="submit">Enviar</button>
      </form>
    )}
  </div></section>
</Base>
