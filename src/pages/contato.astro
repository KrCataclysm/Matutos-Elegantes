---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titulo="Contato" descricao="Fale com a Associação Cultural Matutos Elegantes.">
  <div class="pagina-topo pg-contato"><div class="wrap"><div class="trilha"><a href={`${b}/`}>Início</a> / Contato</div><h1>Contato</h1><p>Fale com a gente — parcerias, projetos e apoio à cultura.</p></div></div>
  <div class="regua" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <section><div class="wrap">
    <a class="contato-linha reveal" href={`mailto:${site.email}`}><span>E-mail</span><strong>{site.email}</strong></a>
    <a class="contato-linha reveal" href={site.instagram} rel="noopener"><span>Instagram</span><strong>{site.instagramUsuario}</strong></a>
    {site.formspree && (
      <form action={site.formspree} method="POST">
        <label><span>Nome</span><input name="nome" autocomplete="name" required /></label>
        <label><span>E-mail</span><input name="email" type="email" autocomplete="email" required /></label>
        <label><span>Mensagem</span><textarea name="mensagem" rows="5" required></textarea></label>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
        <button class="btn" type="submit">Enviar</button>
      </form>
    )}
  </div></section>
</Base>
