---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base titulo="Contato">
  <section><div class="wrap">
    <h1>Contato</h1>
    <ul>
      <li>E-mail: <a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li>WhatsApp: <a href={`https://wa.me/${site.whatsapp}`} rel="noopener">chamar</a></li>
      <li>Instagram: <a href={site.instagram} rel="noopener">{site.instagramUsuario}</a></li>
    </ul>
    {site.formspree && (
      <form action={site.formspree} method="POST">
        <input name="nome" placeholder="Seu nome" required />
        <input name="email" type="email" placeholder="Seu e-mail" required />
        <textarea name="mensagem" rows="5" placeholder="Mensagem" required></textarea>
        <button class="btn" type="submit">Enviar</button>
      </form>
    )}
  </div></section>
  <section class="escuro"><div class="wrap">
    <h2>Instagram</h2>
    <p>Embed oEmbed a ativar quando o perfil oficial for confirmado (ver <code>site.json</code>).</p>
  </div></section>
</Base>
