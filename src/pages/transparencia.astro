---
import Base from '../layouts/Base.astro';
import Bandeirinhas from '../components/Bandeirinhas.astro';
import site from '../data/site.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titulo="Transparência" descricao="Prestação de contas e documentos institucionais da Associação Cultural Matutos Elegantes.">
  <div class="pagina-topo pg-transp">
    <Bandeirinhas />
    <div class="wrap"><div class="trilha"><a href={`${b}/`}>Início</a> / Transparência</div><h1 data-split>Transparência</h1><p>Prestação de contas dos recursos recebidos por editais públicos.</p></div>
  </div>
  <section><div class="wrap">
    <div class="painel-cor reveal">
      <h2>Documentos institucionais</h2>
      <p>Relatórios, planos de trabalho e prestações de contas serão disponibilizados nesta página, organizados por edital e ano.</p>
      <p>Precisa de alguma informação agora? Escreva para <a href={`mailto:${site.email}`}><strong>{site.email}</strong></a>.</p>
    </div>
  </div></section>
</Base>
