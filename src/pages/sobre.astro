---
import Base from '../layouts/Base.astro';
import Bandeirinhas from '../components/Bandeirinhas.astro';
import sobre from '../data/sobre.json';
import historia from '../data/historia.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titulo="Sobre" descricao="Conheça a Associação Cultural Matutos Elegantes, reconhecida como Ponto de Cultura.">
  <div class="pagina-topo pg-sobre">
    <Bandeirinhas />
    <div class="wrap"><div class="trilha"><a href={`${b}/`}>Início</a> / Sobre</div><h1 data-split>Sobre a Matutos Elegantes</h1><p>Associação Cultural · Ponto de Cultura</p></div>
  </div>
  <section><div class="wrap">
    <div class="duas-col">
      <div class="reveal">
        <span class="rotulo">Quem somos</span>
        <h2 data-split>Associação Cultural Matutos Elegantes</h2>
        <p class="texto-grande">{sobre.apresentacao || 'Associação cultural reconhecida como Ponto de Cultura, dedicada à valorização da arte, da tradição e da identidade popular.'}</p>
        {sobre.fundacao && <p><strong>Fundação:</strong> {sobre.fundacao}</p>}
        {sobre.missao && <><h3>Missão</h3><p>{sobre.missao}</p></>}
      </div>
      <p class="texto-lateral reveal">Uma associação cultural que reúne arte, tradição e identidade popular em torno de um Ponto de Cultura.</p>
    </div>
    {sobre.eixos.length > 0 && (
      <div class="eixos" data-stagger>{sobre.eixos.map((e) => <div class="reveal"><h3>{e.titulo}</h3><p>{e.texto}</p></div>)}</div>
    )}
  </div></section>

  <section class="bloco-cor">
    <div class="wrap reveal">
      <span class="rotulo">Para entender</span>
      <h2 data-split>O que é um <em>Ponto de Cultura</em>?</h2>
      <p class="citacao-grande" data-scrub>Pontos de Cultura são organizações culturais da sociedade civil reconhecidas pelo poder público no âmbito da Política Nacional de Cultura Viva, que valorizam a diversidade e fortalecem a cultura nos territórios onde atuam.</p>
    </div>
  </section>

  {historia.itens.length > 0 && (
    <section class="historia"><div class="wrap">
      <span class="rotulo reveal">Nossa trajetória</span>
      <h2 data-split>Uma história que segue em <span class="marca">movimento</span></h2>
      <ol class="tempo" data-timeline>
        <li class="tempo-trilho" aria-hidden="true"><i></i></li>
        {historia.itens.map((h, i) => (
          <li class="tempo-item reveal" data-reveal={i % 2 ? 'dir' : 'esq'}>
            <span class="tempo-ano">{h.ano}</span>
            <div><h3>{h.titulo}</h3><p>{h.texto}</p></div>
          </li>
        ))}
      </ol>
      {historia.exemplo && <p class="aviso-exemplo">Textos ilustrativos, a serem substituídos.</p>}
    </div></section>
  )}

  <section><div class="wrap">
    <div class="chamada reveal">
      <p>Conheça o que já realizamos</p>
      <a class="btn" data-magnetic href={`${b}/projetos`}>Ver projetos →</a>
    </div>
  </div></section>
</Base>
