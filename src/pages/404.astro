---
import Base from '../layouts/Base.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titulo="Página não encontrada">
  <div class="pagina-topo pg-erro"><div class="wrap"><div class="trilha"><a href={`${b}/`}>Início</a> / Erro 404</div><h1>Página não encontrada</h1><p>O endereço pode ter mudado. Volte ao início e continue explorando.</p></div></div>
  <div class="regua" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <section><div class="wrap"><a class="btn" href={`${b}/`}>Voltar ao início</a></div></section>
</Base>
