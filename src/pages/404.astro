---
import Base from '../layouts/Base.astro';
import Bandeirinhas from '../components/Bandeirinhas.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titulo="Página não encontrada">
  <div class="pagina-topo pg-erro">
    <Bandeirinhas />
    <div class="wrap"><div class="trilha"><a href={`${b}/`}>Início</a> / Erro 404</div><h1 data-split>Página não encontrada</h1><p>O endereço pode ter mudado. Volte ao início e continue explorando.</p></div>
  </div>
  <section><div class="wrap"><a class="btn" href={`${b}/`}>Voltar ao início</a></div></section>
</Base>
