---
import Base from '../layouts/Base.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titulo="Página não encontrada">
  <section><div class="wrap" style="text-align:center">
    <span class="kicker">Erro 404</span>
    <h1>Essa página não existe</h1>
    <p class="sub" style="margin:1rem auto 2rem">O endereço pode ter mudado. Volte ao início e continue explorando.</p>
    <a class="btn" href={`${b}/`}>Voltar ao início</a>
  </div></section>
</Base>
