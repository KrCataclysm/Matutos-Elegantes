---
const { class: cls = '' } = Astro.props;
const cores = ['#f0570f','#f19200','#6aa823','#12a4b8','#1f4fa8','#6b3fa0','#e8358a'];
---
<svg class:list={['bandeirinhas', cls]} viewBox="0 0 2400 60" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 4 Q 600 30 1200 4 T 2400 4" fill="none" stroke="currentColor" stroke-width="2.5" />
  {Array.from({ length: 24 }).map((_, i) => {
    const x = i * 100 + 22;
    const y = 4 + 13 * Math.sin((x / 1200) * Math.PI);
    return <polygon points={`${x},${y} ${x + 56},${y} ${x + 28},${y + 40}`} fill={cores[i % 7]} />;
  })}
</svg>
<style>.bandeirinhas{display:block;width:100%;height:clamp(34px,5vw,56px);color:rgba(255,255,255,.55)}</style>
