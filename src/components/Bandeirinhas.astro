---
// Bandeirinhas em paleta contida (palha, terra, creme, anil, verde) — festa sem arco-íris.
const cores = ['#e8b93c', '#c8420a', '#f6efdc', '#1f3f8f', '#4f9d3f'];
---
<svg class="bandeirinhas" viewBox="0 0 2400 60" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 4 Q 600 30 1200 4 T 2400 4" fill="none" stroke="currentColor" stroke-width="2.5" />
  {Array.from({ length: 24 }).map((_, i) => {
    const x = i * 100 + 22;
    const y = 4 + 13 * Math.sin((x / 1200) * Math.PI);
    return <polygon class="flag" style={`--i:${i}`} points={`${x},${y} ${x + 56},${y} ${x + 28},${y + 40}`} fill={cores[i % cores.length]} />;
  })}
</svg>
<style>
  .bandeirinhas{display:block;width:100%;height:clamp(34px,5vw,56px);color:rgba(246,239,220,.5);overflow:visible}
  .flag{transform-box:fill-box;transform-origin:50% 0;animation:cai 1s cubic-bezier(.22,1,.36,1) both,balanca 5.5s ease-in-out infinite;animation-delay:calc(var(--i) * 45ms),calc(1s + var(--i) * 140ms)}
  @keyframes cai{from{transform:translateY(-46px) scaleY(.2);opacity:0}to{transform:none;opacity:1}}
  @keyframes balanca{0%,100%{transform:rotate(-5deg)}50%{transform:rotate(5deg)}}
  @media (prefers-reduced-motion:reduce){.flag{animation:none}}
</style>
