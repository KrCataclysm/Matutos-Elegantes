---
const cores = ['#ff5a14','#f19200','#6aa823','#12a4b8','#1f4fa8','#6b3fa0','#e8358a'];
const n = 28;
---
<svg class="bandeirinhas" viewBox="0 0 2800 70" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 6 Q 700 34 1400 6 T 2800 6" fill="none" stroke="#4a2c17" stroke-width="3" />
  {Array.from({ length: n }).map((_, i) => {
    const x = i * 100 + 20;
    const y = 6 + Math.sin((x / 2800) * Math.PI * 4) * 0 + 14 * Math.sin((x / 1400) * Math.PI);
    return <polygon points={`${x},${y} ${x + 60},${y} ${x + 30},${y + 46}`} fill={cores[i % 7]} stroke="#4a2c17" stroke-width="2.5" stroke-linejoin="round" />;
  })}
</svg>
<style>
  .bandeirinhas{display:block;width:100%;height:56px}
</style>
