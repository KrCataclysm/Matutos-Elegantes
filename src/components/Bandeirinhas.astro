---
// Bandeirinhas em paleta contida (palha, terra, creme, anil, verde) — festa sem arco-íris.
const cores = ['#e8b93c', '#c8420a', '#f6efdc', '#1f3f8f', '#4f9d3f'];
---
<svg class="bandeirinhas" viewBox="0 0 2400 60" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 4 Q 600 30 1200 4 T 2400 4" fill="none" stroke="currentColor" stroke-width="2.5" />
  {Array.from({ length: 24 }).map((_, i) => {
    const x = i * 100 + 22;
    const y = 4 + 13 * Math.sin((x / 1200) * Math.PI);
    return <polygon points={`${x},${y} ${x + 56},${y} ${x + 28},${y + 40}`} fill={cores[i % cores.length]} />;
  })}
</svg>
<style>.bandeirinhas{display:block;width:100%;height:clamp(34px,5vw,56px);color:rgba(246,239,220,.5);transform-origin:50% 0;animation:balanca 7s ease-in-out infinite}@keyframes balanca{0%,100%{transform:rotate(-.3deg)}50%{transform:rotate(.3deg)}}@media (prefers-reduced-motion:reduce){.bandeirinhas{animation:none}}</style>
