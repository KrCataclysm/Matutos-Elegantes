---
import '../styles/global.css';
import site from '../data/site.json';
const { titulo, descricao = 'Matutos Elegantes — Ponto de Cultura e Associação Cultural. Cultura popular, arte e identidade.' } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [['/', 'Início'], ['/sobre', 'Sobre'], ['/projetos', 'Projetos'], ['/transparencia', 'Transparência'], ['/contato', 'Contato']];
const tituloFull = titulo ? `${titulo} · ${site.nome}` : `${site.nome} — Ponto de Cultura`;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{tituloFull}</title>
  <meta name="description" content={descricao} />
  <meta name="theme-color" content="#0a0a0a" />
  <meta property="og:title" content={tituloFull} />
  <meta property="og:description" content={descricao} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(`${b}/og.png`, Astro.site).href} />
  <link rel="icon" type="image/png" href={`${b}/favicon.png`} />
  <link rel="apple-touch-icon" href={`${b}/apple-touch-icon.png`} />
  <link rel="manifest" href={`${b}/manifest.webmanifest`} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <link rel="sitemap" href={`${b}/sitemap-index.xml`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={tituloFull} />
  <meta name="twitter:description" content={descricao} />
  <meta name="twitter:image" content={new URL(`${b}/og.png`, Astro.site).href} />
  <meta property="og:image:alt" content="Matutos Elegantes — Ponto de Cultura" />
  <meta name="color-scheme" content="light" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content={site.nome} />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'NGO', name: 'Associação Cultural Matutos Elegantes', alternateName: 'Matutos Elegantes — Ponto de Cultura', url: new URL(`${b}/`, Astro.site).href, logo: new URL(`${b}/icon-512.png`, Astro.site).href, email: site.email, sameAs: [site.instagram] })} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="pula" href="#conteudo">Pular para o conteúdo</a>
  <header class="topo" id="topo">
    <div class="wrap">
      <a href={`${b}/`} aria-label="Matutos Elegantes — início"><img src={`${b}/logo/logo-escuro.png`} alt="Matutos Elegantes — Ponto de Cultura" /></a>
      <button class="menu-btn" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav id="nav" aria-label="Principal">
        {links.map(([h, t]) => <a href={`${b}${h === '/' ? '/' : h}`} aria-current={path === `${b}${h === '/' ? '' : h}` ? 'page' : undefined}>{t}</a>)}
      </nav>
    </div>
  </header>
  <main id="conteudo"><slot /></main>
  <div class="regua" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <footer>
    <div class="wrap">
      <div><img src={`${b}/logo/logo-escuro.png`} alt="Matutos Elegantes" /></div>
      <div><h4>Navegação</h4>{links.map(([h, t]) => <a href={`${b}${h === '/' ? '/' : h}`}>{t}</a>)}</div>
      <div><h4>Contato</h4><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.instagram} rel="noopener noreferrer" target="_blank">Instagram {site.instagramUsuario}</a></div>
    </div>
    <div class="legal">© {new Date().getFullYear()} Associação Cultural Matutos Elegantes · Ponto de Cultura · <a href="#topo" style="display:inline;min-height:0">Voltar ao topo ↑</a></div>
  </footer>
  <script is:inline>
    const btn = document.querySelector('.menu-btn'), nav = document.getElementById('nav');
    const fecha = () => { nav.classList.remove('aberto'); btn.setAttribute('aria-expanded', 'false'); };
    btn.addEventListener('click', () => btn.setAttribute('aria-expanded', String(nav.classList.toggle('aberto'))));
    nav.addEventListener('click', (e) => e.target.closest('a') && fecha());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('aberto')) { fecha(); btn.focus(); } });
    matchMedia('(min-width:861px)').addEventListener('change', fecha);
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('vis'), io.unobserve(e.target))), { threshold: .12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
